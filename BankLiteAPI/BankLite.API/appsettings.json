{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "YOUR_CONNECTION_STRING"
  },
  "JwtSettings": {
    "Secret": "YOUR_JWT_SECRET_MIN_32_CHARACTERS",
    "Issuer": "BankLiteAPI",
    "Audience": "BankLiteClient",
    "ExpiryMinutes": 60
  },
  "AllowedOrigins": {
    "Frontend": "http://localhost:3000"
  },
  "Frontend": {
    "ResetPasswordUrl": "http://localhost:3000/reset-password.html"
  },
  "Groq": {
    "ApiKey": "YOUR_GROQ_API_KEY"
  },
  "SendGrid": {
    "ApiKey": "YOUR_SENDGRID_API_KEY",
    "FromEmail": "your-email@example.com",
    "FromName": "BankLite"
  }
}